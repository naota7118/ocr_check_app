<div class="wrapper">
  <div class="left-content">
    <%= image_tag "/OCRCheck.png", size: '150x150' %>
    <div class="back-btn">
      <%= link_to wms_path, class: 'btn btn_back' do %>
        <i class="fa-solid fa-arrow-left"></i>ファイル選択画面に戻る
      <% end %>
    </div>
  </div>
  <div class="center-content result-page">
    <div class="result-container">
      <div class="left-container">
        <% @results.each do |result| %>
          <%= result[:id] %>
          <table border="1" style="border-collapse: collapse">
            <tbody>
              <% result[:scores].each_with_index do |score, index| %>
                <% score.each_with_index do |each_score, i| %>
                  <tr>
                    <%# 1つめの配列の最後の要素（問題Aの合計） %>
                    <% if index == 0 && i == score.length - 1 %>
                      <td class="wms_score_a" id="questinA_sum"><%= each_score %></td>
                    <%# 2つめの配列の最後から2番目の要素（問題Bの合計） %>
                    <% elsif index == 1 && i == score.length - 2 %>
                      <td class="wms_score_b" id="questinB_sum"><%= each_score %></td>
                    <%# 2つめの配列の最後の要素（問題A+Bの合計） %>
                    <% elsif index == 1 && i == score.length - 1 %>
                      <td class="wms_score_a_and_b" id="questinAandB_sum"><%= each_score %></td>
                    <%# 1つめの配列の最後以外の要素（問題Aの得点） %>
                    <% elsif index == 0 %>
                      <td class="wms_score_a"><%= each_score %></td>
                    <%# 2つめの配列の最後以外の要素（問題Bの得点） %>
                    <% else %>
                      <td class="wms_score_b"><%= each_score %></td>
                    <% end %>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
      <div class="right-container">
        <div class="guide">
          <p><span class="pink">ピンク色</span>が修正が必要な項目です。</p>
          <p>PDFとExcelを確認してみてください。</p>
        </div>
        <div class="character">
          <%= image_tag "/OCRCheck_character.png", size: '150x150' %>
        </div>
      </div>
    </div>
  </div>
</div>


<script type="module">
  import "wms";
</script>