<div class="wrapper">
  <div class="left-content">
    <%= image_tag "/OCRCheck.png", size: '150x150' %>
    <div class="back-btn">
      <%= link_to wms_path, class: 'btn btn_back' do %>
        <i class="fa-solid fa-arrow-left"></i>ファイル選択画面に戻る
      <% end %>
    </div>
  </div>
  <div class="center-content result-page">
    <div class="result-container">
      <div class="left-container">
        <% @results.each do |person| %>
          <%= person[:id] %>
          <table border="1" style="border-collapse: collapse">
            <tbody>
              <% person[:scores].each_with_index do |story, story_i| %>
                <% story.each_with_index do |score, i| %>
                  <tr>
                    <% if (story_i == 0 && i == 6) && person[:story_a_sum] == false %>
                      <td class="story_a_sum_wrong"><%= score %></td>
                    <% elsif (story_i == 1 && i == 7) && person[:story_b_sum] == false %>
                      <td class="story_b_sum_wrong"><%= score %></td>
                    <% elsif (story_i == 1 && i == 8) && person[:wms_sum] == false %>
                      <td class="wms_sum_wrong"><%= score %></td>
                    <% else %>
                      <td><%= score %></td>
                    <% end %>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
      <div class="right-container">
        <div class="guide">
          <p><span class="pink">ピンク色</span>が修正が必要な項目です。</p>
          <p>PDFとExcelを確認してみてください。</p>
        </div>
        <div class="character">
          <%= image_tag "/OCRCheck_character.png", size: '150x150' %>
        </div>
      </div>
    </div>
  </div>
</div>


<script type="module">
  import "wms";
</script>